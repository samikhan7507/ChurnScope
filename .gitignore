# Python bytecode & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Large binary model artifacts (reproducible via train_pipeline.py or cloud storage)
models/trained/*.joblib
models/artifacts/*.joblib

# Keep tracked evaluation metrics and model registry
!models/artifacts/evaluation_results.json
!models/registry/model_registry.json

# Datasets
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json
data/raw/*.xlsx
data/processed/
data/features/

# Logs, batch outputs & generated plots
logs/
results/
*.log
notebooks/plots/

# Testing, linting & type-checking caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Notebooks checkpoints
.ipynb_checkpoints/

# Editors & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets & environment files (never commit .env!)
.env
.env.*
!.env.example
