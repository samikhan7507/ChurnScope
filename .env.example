# ==============================================================================
# ChurnScope — Complete Environment Variables Template (Local + Render.com)
# ==============================================================================
# Local setup : cp .env.example .env
# Render setup: Either use `render.yaml` (New → Blueprint) for automatic setup,
#               OR copy the exact KEY=VALUE pairs from Sections 1 & 2 below into
#               each Render Web Service → Environment tab.
# SECURITY    : NEVER commit your real `.env` file or real `API_KEY` to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1: RENDER BACKEND SERVICE (`churnscope-api` — FastAPI + LightGBM/SHAP)
# Build Command : pip install --upgrade pip && pip install -r requirements-api.txt && bash scripts/download_data.sh && python train_pipeline.py
# Start Command : uvicorn api.main:app --host 0.0.0.0 --port $PORT --workers $API_WORKERS
# Health Check  : /health/ready
# ------------------------------------------------------------------------------

# Runtime & Python (Render reads PYTHON_VERSION during build)
PYTHON_VERSION=3.11.9
APP_ENV=production
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Configuration & Logging
CONFIG_PATH=config/config.yaml
LOGGING_CONFIG_PATH=config/logging.yaml
LOG_LEVEL=INFO

# API Server Networking
# Note: On Render, `PORT` is injected automatically (default 10000); locally use 8000.
API_HOST=0.0.0.0
API_PORT=8000
# PORT=10000
API_WORKERS=1
API_RELOAD=false

# ML Model & Decision Threshold
MODEL_ALGORITHM=lightgbm
MODEL_VERSION=v1
DEFAULT_THRESHOLD=0.2757
THRESHOLD_STRATEGY=f1
MAX_BATCH_SIZE=1000

# Cold-Start Model Bootstrap (if ephemeral disk has no .joblib model, train automatically)
AUTO_TRAIN_ON_STARTUP=true
AUTO_TRAIN_SAMPLES=7043

# API Security, CORS & Observability
# Leave API_KEY empty for open local access; on Render generate a 32+ char secret
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"` ) and set
# the EXACT SAME API_KEY on BOTH `churnscope-api` and `churnscope-dashboard`.
API_KEY=
DASHBOARD_URL=https://churnscope-dashboard.onrender.com
ALLOWED_ORIGINS=https://churnscope-dashboard.onrender.com,http://localhost:8501,http://127.0.0.1:8501
RATE_LIMIT_PER_MINUTE=120
ENABLE_METRICS=true
ENABLE_DOCS=true

# Render Auto-Injected Metadata (reference only — set automatically by Render, do not override)
# RENDER=true
# RENDER_SERVICE_NAME=churnscope-api
# RENDER_EXTERNAL_URL=https://churnscope-api.onrender.com
# RENDER_EXTERNAL_HOSTNAME=churnscope-api.onrender.com
# RENDER_GIT_BRANCH=main
# RENDER_GIT_COMMIT=


# ------------------------------------------------------------------------------
# SECTION 2: RENDER FRONTEND SERVICE (`churnscope-dashboard` — Streamlit + PWA)
# Build Command : pip install --upgrade pip && pip install -r requirements-dashboard.txt
# Start Command : python run_dashboard.py
# Health Check  : /_stcore/health
# ------------------------------------------------------------------------------

# Dashboard Server Networking (Render injects PORT=10000 automatically; locally 8501)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Backend API Connection
# Local dev   : http://localhost:8000
# Docker      : http://churnscope-api:8000
# Render prod : https://churnscope-api.onrender.com  (replace with your actual Render API URL)
API_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
# Render production override example:
# API_BASE_URL=https://churnscope-api.onrender.com
# PUBLIC_API_URL=https://churnscope-api.onrender.com
API_TIMEOUT_SECONDS=25
# Note: Set `API_KEY` on Render `churnscope-dashboard` to match `churnscope-api`'s `API_KEY`.

# Streamlit Production Server Flags
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_STATIC_SERVING=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Progressive Web App (PWA) Install Manifest Settings (Phone + Laptop Address Bar)
PWA_APP_NAME=ChurnScope — Customer Churn Intelligence
PWA_SHORT_NAME=ChurnScope
PWA_THEME_COLOR=#00d4ff
PWA_BACKGROUND_COLOR=#020408


# ------------------------------------------------------------------------------
# SECTION 3: OPTIONAL MONITORING & RETRAINING ALERTS (Docker Compose / Cron)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Slack notifications for `NOTIFY=1 bash scripts/retrain.sh`
SLACK_WEBHOOK_URL=
ALERT_EMAIL=


# ------------------------------------------------------------------------------
# SECTION 4: OPTIONAL EXTERNAL INTEGRATIONS (Kaggle / Storage / MLflow)
# ------------------------------------------------------------------------------
# Kaggle dataset download (`bash scripts/download_data.sh --kaggle`)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Optional experiment tracking & remote artifact storage
# DATABASE_URL=postgresql://user:password@host:5432/churnscope
# MLFLOW_TRACKING_URI=https://your-mlflow-server.onrender.com
# MLFLOW_EXPERIMENT_NAME=churnscope
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# S3_BUCKET=churnscope-artifacts
